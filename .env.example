# CTIB Configuration
# Copy to .env and fill in your values

# Google Gemini API Key (required for AI nodes)
GEMINI_API_KEY=your-gemini-api-key-here

# FHIR Server
FHIR_BASE_URL=http://localhost:8080/fhir

# LLM Model
LLM_MODEL=gemini-2.0-flash

# Server Ports
CTIB_PORT=9000
PHARMSAFETY_MCP_PORT=9001
VITALSTREND_MCP_PORT=9002
NARRATIVESEMANT_MCP_PORT=9003
POPULATIONSIGNAL_MCP_PORT=9004
DISSONANCE_MCP_PORT=9005
